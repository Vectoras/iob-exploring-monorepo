{
  "name": "@iob-exploring-monorepo/api-ts-name-generator",
  "private": true,
  "version": "0.0.1",
  "description": "Simple Fastify API that returns a random username and id",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev:lean": "tsx watch src/index.ts",
    "dev:debug": "tsx watch --inspect=0.0.0.0:9229 src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@iob-exploring-monorepo/go-types": "workspace:*",
    "@iob-exploring-monorepo/ts-types": "workspace:*",
    "fastify": "^5.12.3",
    "unique-names-generator": "^4.7.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
