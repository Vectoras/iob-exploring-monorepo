{
  "compilerOptions": {
    "declaration": true,
    "rootDir": "./ts/generated",
    "outDir": "./ts/dist",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["./ts/generated/**/*.ts"],
  "exclude": ["./ts/dist"]
}
