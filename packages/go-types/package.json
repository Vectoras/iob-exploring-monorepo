{
  "name": "@iob-exploring-monorepo/go-types",
  "version": "0.0.1",
  "private": true,
  "description": "types common to go and ts apps, ts generated with tygo",
  "main": "./ts/dist/index.js",
  "scripts": {
    "generate": "go tool tygo generate",
    "build": "pnpm run generate && tsc",
    "dev": "go tool wgo -file .go go tool tygo generate :: tsc",
    "lint": "golangci-lint run --fix ./...",
    "lint:check": "golangci-lint run ./...",
    "format": "golangci-lint fmt ./... && prettier --write . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "format:check": "golangci-lint fmt -d ./... && prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "exports": {
    ".": {
      "development": "./ts/generated/index.ts",
      "types": "./ts/dist/index.d.ts",
      "default": "./ts/dist/index.js"
    }
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
