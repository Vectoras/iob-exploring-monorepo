{
  "private": true,
  "name": "exploring_monorepo",
  "version": "0.0.0",
  "description": "Understanding monorepos with pnpm and turborepo",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
