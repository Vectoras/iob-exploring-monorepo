{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@iob-exploring-monorepo/web#build": {
      "dependsOn": ["^build"],
      "outputs": [".svelte-kit/output/**"]
    },
    "@iob-exploring-monorepo/go-types#build": {
      "dependsOn": ["^build"],
      "outputs": ["ts/dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "cache": false
    },
    "lint:check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.js",
        "$TURBO_ROOT$/.gitignore"
      ]
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.prettierrc",
        "$TURBO_ROOT$/.prettierignore",
        "$TURBO_ROOT$/.editorconfig",
        "$TURBO_ROOT$/.gitignore"
      ]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "storybook": {}
  }
}
