{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@iob-exploring-monorepo/web#build": {
      "dependsOn": ["^build"],
      "outputs": [".svelte-kit/output/**"]
    },
    "@iob-exploring-monorepo/go-types#build": {
      "dependsOn": ["^build"],
      "outputs": ["ts/dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "storybook": {}
  }
}
